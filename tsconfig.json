{
  "compilerOptions": {
    "baseUrl": ".",
    "inlineSourceMap": true,
    "inlineSources": true,
    "module": "ESNext",
    "target": "ES2022",
    // ES2022 would otherwise turn this on, which defines class fields instead of
    // assigning them. Obsidian's base classes assign to fields in their constructors,
    // so defining would shadow what they set.
    "useDefineForClassFields": false,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "node",
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"],
    // Indexing an array yields `T | undefined`: the code below assumes a non-empty
    // result in several places, and those assumptions should be visible.
    "noUncheckedIndexedAccess": true
  },
  "include": ["**/*.ts"],
  "exclude": ["__tests__/**", "__mocks__/**", "node_modules/**"]
}
